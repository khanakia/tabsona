{
  "manifest_version": 3,
  "name": "Tabsona — multi-account tabs & saved logins",
  "short_name": "Tabsona",
  "version": "0.2.0",
  "description": "Give each tab its own login. Save a set of signed-in sites as a persona and reopen the whole set in one click.",
  "homepage_url": "https://github.com/khanakia/tabsona",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "cookies",
    "tabGroups"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tabsona",
    "default_popup": "src/surfaces/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open the session list"
    }
  },
  "options_ui": {
    "page": "src/surfaces/options/index.html",
    "open_in_tab": true
  }
}
